#!/bin/bash

# Configuration for UVA Anywhere
VPN_GATEWAY="uva-anywhere-1.itc.virginia.edu"

# Path to your PKCS#12 (.p12) certificate file
CERT_PATH="/user/home/.ssh/luc.p12"

# Your UVA Computing ID
USER_ID="blue"

# Ensure openconnect is installed
if ! command -v openconnect &> /dev/null; then
    echo "Error: openconnect is not installed. Install it via your package manager (e.g., sudo apt install openconnect)."
    exit 1
fi

# Verify certificate existence
if [ ! -f "$CERT_PATH" ]; then
    echo "Error: Certificate not found at $CERT_PATH"
    exit 1
fi

echo "=== Connecting to UVA Anywhere VPN ==="
echo "Gateway:     $VPN_GATEWAY"
echo "User ID:     $USER_ID"
echo "Certificate: $CERT_PATH"
echo ""

# Run openconnect with root privileges required for tun interface creation
sudo openconnect \
    --certificate="$CERT_PATH" \
    --user="$USER_ID" \
    "$VPN_GATEWAY"
